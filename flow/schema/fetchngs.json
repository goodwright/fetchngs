{
    "inputs": [
        {
            "name": "Accessions & metadata",
            "description": "One row per public-repository accession to import. fetchngs downloads the reads for each accession.",
            "params": {
                "input": {
                    "name": "Accessions",
                    "type": "csv",
                    "required": true,
                    "allow_custom_columns": true,
                    "columns": [
                        {
                            "name": "accession",
                            "type": "string",
                            "required": true,
                            "render": true
                        }
                    ]
                },
                "outdir": {
                    "type": "hidden",
                    "default": "results"
                }
            }
        }
    ],
    "outputs": [
        {
            "name": "Samplesheet",
            "description": "The samplesheet mapping each accession's runs to their downloaded FASTQ files.",
            "filetype": "csv",
            "process": "SRA_TO_SAMPLESHEET"
        }
    ]
}
