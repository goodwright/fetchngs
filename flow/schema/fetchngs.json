{
    "inputs": [
        {
            "name": "Accessions & metadata",
            "description": "One row per public-repository accession to import. fetchngs downloads the reads for each accession; the other columns set the identity and metadata of the Flow sample created from it once the run completes. Add extra columns for any additional metadata you want to record.",
            "params": {
                "input": {
                    "name": "Accessions",
                    "type": "csv",
                    "required": true,
                    "allow_custom_columns": true,
                    "columns": [
                        {
                            "name": "accession",
                            "type": "string",
                            "required": true,
                            "render": true
                        },
                        {
                            "name": "name",
                            "type": "string",
                            "required": false,
                            "render": true
                        },
                        {
                            "name": "sample_type",
                            "type": "string",
                            "required": true,
                            "render": true
                        },
                        {
                            "name": "organism",
                            "type": "string",
                            "required": true,
                            "render": true
                        }
                    ]
                },
                "outdir": {
                    "type": "hidden",
                    "default": "results"
                }
            }
        }
    ],
    "outputs": [
        {
            "name": "Samplesheet",
            "description": "The samplesheet mapping each accession's runs to their downloaded FASTQ files.",
            "filetype": "csv",
            "process": "SRA_TO_SAMPLESHEET"
        },
        {
            "name": "FASTQ files",
            "description": "The FASTQ files downloaded for each accession.",
            "filetype": "fastq.gz",
            "process": "SRA_FASTQ_FTP"
        }
    ]
}
